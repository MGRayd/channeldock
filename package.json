{
  "name": "channeldock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsup src/server/index.ts --format esm --out-dir dist/server --external better-sqlite3",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "diagnose:stream": "tsx scripts/diagnose-stream.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
